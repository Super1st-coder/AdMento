# Copy to /opt/admento/.env.deploy on the VPS and fill in. Never commit the real file.
# Generate secrets with: openssl rand -hex 32
# (hex only: Sinergia's config parser breaks on '%' characters)

PUBLIC_BASE_URL=http://168.231.105.83

DATABASE_USERNAME=admento
DATABASE_PASSWORD=

STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=
STRAPI_ADMIN_JWT_SECRET=
STRAPI_TRANSFER_TOKEN_SALT=
STRAPI_JWT_SECRET=
# Create in Strapi admin > Settings > API Tokens after the first deploy, then redeploy
STRAPI_TOKEN=

LUCA_CREDITS_INTERNAL_KEY=
GUIDE_INTERNAL_API_KEY=

# Optional integrations (features that need them stay off while blank)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
GCS_BUCKET_NAME=
GCS_SA_KEY_JSON=
SENDGRID_SECRET_KEY=
SENDGRID_ACCOUNT_CONFIRMATION_TEMPLATE=
SENDGRID_RESET_PASSWORD_TEMPLATE=
SENDGRID_EMAIL_FROM=
IMAGE_LIBRARY_URL=
IMAGE_LIBRARY_TOKEN=
ABYSSALE_URL=
ABYSSALE_TOKEN=
FURY_URL=
FURY_SERVICE_API_KEY=
FONT_BUCKET_NAME=
